{
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp"
      ],
      "description": "文件系统访问服务器",
      "enabled": true
    },
    "weather": {
      "type": "streamableHttp",
      "url": "http://localhost:8000/mcp",
      "description": "天气信息服务器",
      "timeout": 30,
      "enabled": true
    },
    "database": {
      "type": "stdio",
      "command": "python",
      "args": [
        "db_server.py"
      ],
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "5432"
      },
      "description": "数据库访问服务器",
      "enabled": false
    }
  }
}